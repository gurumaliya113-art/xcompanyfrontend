# Add your DCE passcode here. The frontend reads this value using Vite.
VITE_DCE_PASSCODE=1234

# Backend API URL for email notifications and server actions.
# Set this to the running backend host, for example:
# VITE_BACKEND_URL=http://localhost:3000
# If omitted, localhost:3000 is used in dev and current origin in production.
VITE_BACKEND_URL=
